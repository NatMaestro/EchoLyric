# Neon — Project Dashboard → Connection string (use pooled "Transaction" for serverless if offered)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js — REQUIRED for sessions (empty value breaks /api/auth/session with ClientFetchError).
# Generate: npx auth secret   OR   openssl rand -base64 32
AUTH_SECRET=
# Optional; helps OAuth redirects in some setups
AUTH_URL=http://localhost:3000

# Google AdSense (optional)
# Use the publisher ID in this form: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# Create one ad unit for mobile inline placements
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE_INLINE=
# Create one ad unit for desktop right-rail placement
NEXT_PUBLIC_ADSENSE_SLOT_DESKTOP_RAIL=

# Google OAuth — Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and production URL on deploy)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth — Developer Settings → OAuth Apps → create app
# Authorization callback URL: http://localhost:3000/api/auth/callback/github (and production URL on deploy)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email/password sign-up & sign-in require DATABASE_URL (users stored in Postgres).
# No extra env vars — use /signup to register, then sign in with the same email.

# Comma-separated GitHub account emails that become admins on first sign-in
ADMIN_EMAILS=you@example.com

# Optional: comma-separated emails that can approve/reject lyric submissions (review queue), not full admin
CURATOR_EMAILS=
